PRGSTART

SECTION VARS,//ONE NAME DECLARED TWICE, AND ONE TOO LONG//
        DEC TOTAL INIT 0
        DEC TOTAL INIT 1
        DEC OVERLONG INIT 0
        DEC AB INIT 0
ENDSECT VARS

SECTION MAIN,//A BRANCH AND A VALUE THAT NAME NOTHING//

[BEGIN] SET TOTAL = MISSNG+OVERLONG+AB
        GO TO NOWHER
        GO TO NOWHER

ENDSECT MAIN

PRGEND
