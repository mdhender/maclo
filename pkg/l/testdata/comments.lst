    1 PRGSTART
    2 /+A HEADING, WHICH OCCUPIES A LINE BY ITSELF+/
    3 //A SUBSIDIARY COMMENT ON A LINE OF ITS OWN//
    4 //A COMMENT WHOSE TEXT CONTAINS A / SLASH//
    6 SECTION VARS,//AFTER A COMMA THE COMMENT IS AN ARGUMENT//
    7   DEC TOTAL INIT 0
    8 ENDSECT VARS
   10 SECTION INVALS,//PREFIXES SIT ON EITHER SIDE OF THE LABEL//
   12   [BEGIN] /-IN-/ SET TOTAL = 0
   13   /-IN-/ /-OVP-/ SET TOTAL = TOTAL+1
   14   GO TO MBEGIN
   16 ENDSECT INVALS
   18 SECTION MAIN,//AND ON THE STATEMENT AFTER THEN//
   20   [MBEGIN] /-CSS-/ IF TOTAL = 0 THEN /-OVP-/ SET TOTAL = TOTAL+1
   21   GO TO MBEGIN
   23 ENDSECT MAIN
   25 PRGEND
