PRGSTART

SECTION VARS,//THE CHAIN VARIABLES ARE DECLARED LIKE ANY OTHER//
        DEC CHANPT INIT NULLPT
        DEC CHLINK INIT 0
        DEC PARPT INIT NULLPT
        DEC DELPT INIT NULLPT
        DEC TOTAL INIT 0
ENDSECT VARS

SECTION MAIN,//A CHAIN WHOSE ENDCH CARRIES A BRANCHED-TO LABEL//

[BEGIN] CHAIN FROM DELPT EXIT NOTFND
                CALL COMPAR(CHANPT)PT EXIT SKIPIT
                SET TOTAL = TOTAL+1
                IF CHLINK = 0 THEN GO TO SKIPIT
[SKIPIT]        ENDCH
[NOTFND]        GO TO BEGIN

ENDSECT MAIN

SECTION MAINSUBS,//THE SUBROUTINE THE CHAIN CALLS//

SUBROUTINE COMPAR(PARPT) EXIT //THE COMPARISON FAILS//
        IF PARPT = NULLPT THEN EXIT FROM COMPAR
        RETURN FROM COMPAR
ENDSUB

ENDSECT MAINSUBS

PRGEND
