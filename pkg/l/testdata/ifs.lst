    1 PRGSTART
    3 SECTION VARS,//NAMES FOR THE CONDITIONS BELOW//
    4   DEC LEVEL INIT 0
    5   DEC DEPTH INIT 0
    6   DEC SPT INIT ZEROPT
    7   DEC IDPT INIT ZEROPT
    8   DEC OHSW INIT 0
    9 ENDSECT VARS
   11 SECTION MAIN,//BOTH FORMS OF IF, AND EVERY COMPARISON//
   13   [BEGIN] IF LEVEL = 0 THEN GO TO DONE
   14   IF LEVEL NE 0 THEN GO TO DONE
   15   IF LEVEL GR DEPTH THEN GO TO DONE
   16   IF LEVEL GE DEPTH THEN GO TO DONE
   17   IF LEVEL LE DEPTH THEN GO TO DONE
   18   IF SPT = IDPT THEN SET LEVEL = 0
   19   IF OHSW = TRUE THEN READ
   21   //A CONDITION OF THREE RELATIONS, JOINED ONE WAY THEN THE OTHER//
   23   IF LEVEL = 0 & DEPTH = 0 & OHSW = FALSE THEN GO TO DONE
   24   IF LEVEL NE 0 | DEPTH NE 0 THEN GO TO DONE
   26   //THE BLOCK FORM, WITH A ONE LINE IF INSIDE IT//
   28   IF IND(SPT)CH = '*' THEN
   29     SET LEVEL = LEVEL+1
   30     IF DEPTH = 0 THEN GO TO DONE
   31     SET DEPTH = DEPTH-1
   32   END
   34   [DONE] GO TO BEGIN
   36 ENDSECT MAIN
   38 PRGEND
