PRGSTART

SECTION VARS,//NAMES FOR THE BLOCK MOVES//

BLOCKDEC SDB,//A BLOCK, SO THAT BLOCK( ) HAS SOMETHING TO NAME//
        DEC STAKPT INIT NULLPT
        DEC ARGCT INIT 0
ENDBLOCK SDB

DEC FROMPT INIT NULLPT
DEC DESTPT INIT NULLPT
DEC IDLEN INIT 0

ENDSECT VARS

SECTION MAIN,//EVERY BLOCK MOVING STATEMENT//

[BEGIN] MOVE FROM FROMPT TO DESTPT LENG IDLEN
        MOVE FROM FROMPT TO DESTPT LENG IDLEN BACKWARDS
        MOVE FROM BLOCK(SDB) TO DESTPT LENG OF(LPT+LNM)
        MSTACK FROM FROMPT LENG IDLEN ON FSTACK
        MSTACK FROM BLOCK(SDB) LENG SDBSZ ON BSTACK
        MUNSTACK FROM FROMPT TO BLOCK(SDB) LENG SDBSZ FROM BSTACK
        SET STAKPT = FROMPT
        SET ARGCT = IDLEN
        GO TO BEGIN

ENDSECT MAIN

PRGEND
