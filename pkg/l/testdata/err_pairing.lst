    1 PRGSTART
    3 SECTION VARS,//THE NAME ON THE CLOSER DOES NOT MATCH//
    4   BLOCKDEC SDB,//NOR DOES THIS ONE//
    5     DEC TOTAL INIT 0
    6   ENDBLOCK ODB
    7 ENDSECT VARIABLES
    9 SECTION MAIN,//A CLOSER WITH NOTHING OPEN//
   10   [BEGIN] SET TOTAL = 0
   12   GO TO BEGIN
   13 ENDSECT MAIN
   15 PRGEND
