PRGSTART

SECTION VARS,//NAMES FOR THE EXPRESSIONS BELOW//
        DEC TOTAL INIT 0
        DEC OTHER INIT 0
        DEC FLGSW INIT 0
ENDSECT VARS

SECTION MAIN,//OPERATORS AND MACROS OUTSIDE THE PLACES THEY BELONG//

[BEGIN] SET TOTAL = 2*OTHER
        SET TOTAL = OTHER/2
        SET TOTAL = RL(BEGIN)
        IF TOTAL = 0 & OTHER = 0 | FLGSW = 1 THEN GO TO BEGIN
        GO TO BEGIN

ENDSECT MAIN

PRGEND
