    1 PRGSTART
    3 SECTION VARS,//ONE VARIABLE FOR THE ROUTINES BELOW//
    4   DEC TOTAL INIT 0
    5   DEC PARPT INIT NULLPT
    6 ENDSECT VARS
    8 SECTION MAIN,//CALLS THAT DO NOT AGREE WITH THEIR DECLARATIONS//
   10   [BEGIN] CALL PLAIN EXIT BEGIN
   11   CALL NEEDS
   12   CALL PLAIN(TOTAL)NM
   13   GO TO BEGIN
   15 ENDSECT MAIN
   17 SECTION MAINSUBS,//AND ROUTINE STATEMENTS IN THE WRONG ROUTINE//
   19   SUBROUTINE PLAIN
   20     EXIT FROM PLAIN
   21     RETURN FROM NEEDS
   22     LINK BACK
   23   ENDSUB
   25   SUBROUTINE NEEDS(PARPT) EXIT //NOT FOUND//
   26     SET TOTAL = 0
   27     RETURN FROM NEEDS
   28   ENDSUB
   30 ENDSECT MAINSUBS
   32 PRGEND
