    1 PRGSTART
    3 SECTION VARS,//ONE VARIABLE, AND SEVERAL WAYS TO MISWRITE A LINE//
    4   DEC TOTAL INIT 0
    5 ENDSECT VARS
    7 SECTION MAIN,//THE SCANNER AND THE LINE PARSER EACH REPORT AND CARRY ON//
    9   [BEGIN] SET TOTAL = ??
   10   SET TOTAL = 1
   12   SET TOTAL = 3
   14   SET TOTAL = OF(LCH)
   15   GO TO BEGIN
   17 ENDSECT MAIN
   19 PRGEND
