    1 PRGSTART
    3 SECTION VARS,//NAMES FOR THE BRANCHES AND ASSIGNMENTS//
    5   BLOCKDEC SDB,//BACKSPACE READS A VARIABLE OF THIS BLOCK//
    6     DEC DBUGPT INIT NULLPT
    7     DEC SPT INIT ZEROPT
    8   ENDBLOCK SDB
   10   DEC IDPT INIT ZEROPT
   11   DEC BESPT INIT ZEROPT
   12   DEC BESTPL INIT 0
   13   DEC PVNUM INIT 0
   14   DEC TEMP INIT 0
   15   DEC FLAGSW INIT 0
   16   DEC COPDSW INIT 0
   18 ENDSECT VARS
   20 SECTION MAIN,//GO TO, TEST, CHARMATCH, SCALE, BACKSPACE, SET, SETSW, STACK//
   22   [BEGIN] GO TO SWITCH
   24   [SWITCH] TEST BESTPL GOING MNOUT,CALLO,WARNO,SKIPPO,DELLO,BSLOOP,WRNERR,SASTAK,STOPPO,ENDALL
   26   [MNOUT] CHARMATCH IDPT,'+' GOING CALLO,'-' GOING WARNO,'*' GOING SKIPPO,'/' GOING DELLO,'$' GOING BSLOOP
   28   [CALLO] BACKSPACE SPT
   29   [WARNO] BACKSPACE SPT GIVING IDPT
   30   [SKIPPO] SCALE PVNUM BY 4
   31   [DELLO] SCALE PVNUM BY 4 GIVING TEMP
   33   [BSLOOP] SET SPT = IDPT-OF(LNM)
   34   SET IND(SPT)NM,TEMP = 0
   35   SET BESTPL,PVNUM = 0
   36   SETSW FLAGSW = 1
   37   SETSW FLAGSW = COPDSW
   38   SETSW FLAGSW = COPDSW & 4
   39   SETSW FLAGSW = COPDSW | 1
   41   [WRNERR] STACK PVNUM(NM) ON FSTACK
   42   [SASTAK] STACK IDPT(PT) BESPT+OF(LCH)(PT) ON BSTACK
   43   [STOPPO] STACK FLAGSW(SW) 3(NM) TRUE(SW) IDPT-1(PT) ON FSTACK
   44   [ENDALL] UNSTACK TEMP(NM) IDPT(PT) FROM BSTACK
   45   SET DBUGPT = IDPT
   46   SET BESPT = IDPT
   47   GO TO BEGIN
   49 ENDSECT MAIN
   51 PRGEND
