PRGSTART

SECTION VARS,//A DECLARATION OF EVERY SHAPE//

BLOCKDEC OUTER,//A BLOCK, AND ONE NESTED INSIDE IT//

        DEC COUNT
        DEC BASEPT INIT NULLPT

        BLOCKDEC INNER,//THE NESTED CASE, WHICH THE LOGIC USES ONCE//

                DEC FLGSW INIT 0
                DEC LIMIT INIT 9

        ENDBLOCK INNER

ENDBLOCK OUTER

DEC HEADPT INIT AD(TABLE)PT
DEC TOTAL INIT 3
DEC SPARE
EQUATE OTHER TO TOTAL

ENDSECT VARS

SECTION MAIN,//EVERY NAME IS USED, SO NOTHING IS REPORTED UNUSED//

[BEGIN] SET COUNT = OUTERSZ+INNERSZ
        SET BASEPT = HEADPT
        SETSW FLGSW = 1
        SET TOTAL = LIMIT+OTHER
        SET SPARE = COUNT
        GO TO BEGIN

ENDSECT MAIN

SECTION MACNAMES,//A DATA LABEL FOR AD TO NAME//

[TABLE] DC 0

ENDSECT MACNAMES

PRGEND
