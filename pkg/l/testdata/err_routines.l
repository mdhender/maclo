PRGSTART

SECTION VARS,//ONE VARIABLE FOR THE ROUTINES BELOW//
        DEC TOTAL INIT 0
        DEC PARPT INIT NULLPT
ENDSECT VARS

SECTION MAIN,//CALLS THAT DO NOT AGREE WITH THEIR DECLARATIONS//

[BEGIN] CALL PLAIN EXIT BEGIN
        CALL NEEDS
        CALL PLAIN(TOTAL)NM
        GO TO BEGIN

ENDSECT MAIN

SECTION MAINSUBS,//AND ROUTINE STATEMENTS IN THE WRONG ROUTINE//

SUBROUTINE PLAIN
        EXIT FROM PLAIN
        RETURN FROM NEEDS
        LINK BACK
ENDSUB

SUBROUTINE NEEDS(PARPT) EXIT //NOT FOUND//
        SET TOTAL = 0
        RETURN FROM NEEDS
ENDSUB

ENDSECT MAINSUBS

PRGEND
