PRGSTART

SECTION VARS,//A BLOCK AND A VARIABLE FOR THE MISUSES BELOW//
BLOCKDEC SDB,//A BLOCK//
        DEC TOTAL INIT 0
ENDBLOCK SDB
DEC DESTPT INIT NULLPT
ENDSECT VARS

SECTION MAIN,//AD, BLOCK AND GO TO EACH NAMING THE WRONG KIND OF THING//

[BEGIN] SET DESTPT = AD(BEGIN)PT
        MOVE FROM BLOCK(TOTAL) TO DESTPT LENG SDBSZ
        GO TO TOTAL
        CALL TOTAL

ENDSECT MAIN

PRGEND
