    1 PRGSTART
    3 SECTION VARS,//NAMES FOR THE EXPRESSIONS BELOW//
    4   DEC SPT INIT ZEROPT
    5   DEC IDPT INIT ZEROPT
    6   DEC IDLEN INIT 0
    7   DEC HASHPT INIT NULLPT
    8   DEC FLAGSW INIT 0
    9 ENDSECT VARS
   11 SECTION MAIN,//EVERY SHAPE OF EXPRESSION AND CONSTANT MACRO//
   13   [BEGIN] SET IDLEN = OF(LCH)
   14   SET IDLEN = OF(2*LNM+LCH)
   15   SET IDLEN = OF(LHV+4*LPT+LSW)
   16   SET IDLEN = OF(LNM-LCH)
   17   SET IDLEN = OF(1/LICH)
   18   SET SPT = IDPT-OF(LNM)
   19   SET SPT = -6+IDLEN
   20   SET IDLEN = IND(SPT)NM
   21   SETSW FLAGSW = IND(HASHPT+IDLEN-OF(LCH))SW
   22   SET IDLEN = IND(AD(KSPACE)PT)NM
   23   SET IND(SPT)NM,IDLEN = 0
   24   SET HASHPT = AD(KSPACE)PT
   25   SET IDLEN = TEXMAX-HTMAX
   26   GO TO BEGIN
   28 ENDSECT MAIN
   30 SECTION DELS,//A DATA LABEL FOR AD TO NAME//
   31   [KSPACE] DC ' '
   32 ENDSECT DELS
   34 PRGEND
