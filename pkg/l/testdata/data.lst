    1 PRGSTART
    3 SECTION VARS,//THE DATA SECTIONS BELOW NEED NO VARIABLES//
    4 ENDSECT VARS
    6 SECTION MAIN,//AD NAMES THE DATA LABELS, SO THEY ARE NOT UNUSED//
    8   [BEGIN] CALL MDOP
    9   GO TO BEGIN
   11 ENDSECT MAIN
   13 SECTION MACNAMES,//OPMAC IN BOTH ITS FORMS//
   15   OPMAC 'MCDEF',RL(DVARS),OPMK,1
   16   OPMAC 'MCSET',ENDCHN,OPMK,2
   17   OPMAC 'MCSUB'+'(',RL(DCOM1),LOCMK,14
   19 ENDSECT MACNAMES
   21 SECTION DELS,//DC WITH AN ARGUMENT OF EVERY KIND, AND THE TWO TABLE STATEMENTS//
   23   [DVARS] DC ENDCHN,OF(LCH)
   24   [DCOM1] DC ' ',0,ENDCHN
   25   DC LID[SPACES]
   26   DC RL(DVARS),RL(DVARS+OF(LNM)),RL(DCOM1-1)
   27   DC OF(2*LNM),TRUE,NULLPT
   29   [LAYCHN] LAYCHAIN
   30   HETABLES
   32 ENDSECT DELS
   34 PRGEND
