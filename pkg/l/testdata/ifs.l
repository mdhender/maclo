PRGSTART

SECTION VARS,//NAMES FOR THE CONDITIONS BELOW//
        DEC LEVEL INIT 0
        DEC DEPTH INIT 0
        DEC SPT INIT ZEROPT
        DEC IDPT INIT ZEROPT
        DEC OHSW INIT 0
ENDSECT VARS

SECTION MAIN,//BOTH FORMS OF IF, AND EVERY COMPARISON//

[BEGIN] IF LEVEL = 0 THEN GO TO DONE
        IF LEVEL NE 0 THEN GO TO DONE
        IF LEVEL GR DEPTH THEN GO TO DONE
        IF LEVEL GE DEPTH THEN GO TO DONE
        IF LEVEL LE DEPTH THEN GO TO DONE
        IF SPT = IDPT THEN SET LEVEL = 0
        IF OHSW = TRUE THEN READ

//A CONDITION OF THREE RELATIONS, JOINED ONE WAY THEN THE OTHER//

        IF LEVEL = 0 & DEPTH = 0 & OHSW = FALSE THEN GO TO DONE
        IF LEVEL NE 0 | DEPTH NE 0 THEN GO TO DONE

//THE BLOCK FORM, WITH A ONE LINE IF INSIDE IT//

        IF IND(SPT)CH = '*' THEN
                SET LEVEL = LEVEL+1
                IF DEPTH = 0 THEN GO TO DONE
                SET DEPTH = DEPTH-1
        END

[DONE]  GO TO BEGIN

ENDSECT MAIN

PRGEND
