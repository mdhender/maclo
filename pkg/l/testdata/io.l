PRGSTART

SECTION VARS,//ONE FLAG FOR THE LOOP BELOW//
        DEC OHSW INIT 0
ENDSECT VARS

SECTION ERR,//READ, OUTPUTID AND EVERY SHAPE OF PRTEXT//

[BEGIN] READ
        OUTPUTID
        PRTEXT[A PLAIN LINE]
        PRTEXT[$]
        PRTEXT[$$$SOMETHING WENT WRONG$]
        PRTEXT[)    ]
        PRTEXT[]
        PRTEXT[, = + - * / AND ; ARE ALL LEGAL HERE]

//THE NAME IN THESE BRACKETS IS ALSO A LABEL OF THIS PROGRAM//

[TXTO]  PRTEXT[SKIP]
[SKIP]  SETSW OHSW = 0
        IF OHSW = 0 THEN GO TO SKIP
        GO TO TXTO

ENDSECT ERR

PRGEND
