PRGSTART

SECTION VARS,//THE DATA SECTIONS BELOW NEED NO VARIABLES//
ENDSECT VARS

SECTION MAIN,//AD NAMES THE DATA LABELS, SO THEY ARE NOT UNUSED//

[BEGIN] CALL MDOP
        GO TO BEGIN

ENDSECT MAIN

SECTION MACNAMES,//OPMAC IN BOTH ITS FORMS//

OPMAC 'MCDEF',RL(DVARS),OPMK,1
OPMAC 'MCSET',ENDCHN,OPMK,2
OPMAC 'MCSUB'+'(',RL(DCOM1),LOCMK,14

ENDSECT MACNAMES

SECTION DELS,//DC WITH AN ARGUMENT OF EVERY KIND, AND THE TWO TABLE STATEMENTS//

[DVARS] DC ENDCHN,OF(LCH)
[DCOM1] DC ' ',0,ENDCHN
        DC LID[SPACES]
        DC RL(DVARS),RL(DVARS+OF(LNM)),RL(DCOM1-1)
        DC OF(2*LNM),TRUE,NULLPT

[LAYCHN] LAYCHAIN
HETABLES

ENDSECT DELS

PRGEND
