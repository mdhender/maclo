    1 PRGSTART
    3 SECTION VARS,//NAMES FOR THE EXPRESSIONS BELOW//
    4   DEC TOTAL INIT 0
    5   DEC OTHER INIT 0
    6   DEC FLGSW INIT 0
    7 ENDSECT VARS
    9 SECTION MAIN,//OPERATORS AND MACROS OUTSIDE THE PLACES THEY BELONG//
   11   [BEGIN] SET TOTAL = 2*OTHER
   12   SET TOTAL = OTHER/2
   13   SET TOTAL = RL(BEGIN)
   14   IF TOTAL = 0 | OTHER = 0 | FLGSW = 1 THEN GO TO BEGIN
   15   GO TO BEGIN
   17 ENDSECT MAIN
   19 PRGEND
