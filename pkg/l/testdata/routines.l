PRGSTART

SECTION VARS,//NAMES THE ROUTINES BELOW USE//
        DEC PARPT INIT NULLPT
        DEC PARNM INIT 0
        DEC PARSW INIT 0
        DEC TOTAL INIT 0
        DEC FLGSW INIT 0
ENDSECT VARS

SECTION MAIN,//A CALL OF EVERY FORM//

[BEGIN] CALL PLAIN
        CALL WITHPT(TOTAL)PT EXIT FAILED
        CALL WITHNM(TOTAL+1)NM
        CALL WITHSW(FLGSW)SW
        CALL MDINIT
        CALL MDTEST(PARPT)PT EXIT FAILED
[FAILED] GO TO BEGIN

ENDSECT MAIN

SECTION MAINSUBS,//SUBROUTINES WITH AND WITHOUT A PARAMETER AND AN EXIT//

SUBROUTINE PLAIN
        SET TOTAL = 0
        RETURN FROM PLAIN
ENDSUB

SUBROUTINE WITHPT(PARPT) EXIT //THE VALUE WAS NOT FOUND//
        IF PARPT = NULLPT THEN EXIT FROM WITHPT
        SET TOTAL = PARNM
        RETURN FROM WITHPT
ENDSUB

SUBROUTINE WITHNM(PARNM)
        SET TOTAL = PARNM
        RETURN FROM WITHNM
ENDSUB

SUBROUTINE WITHSW(PARSW)
        SETSW FLGSW = PARSW
        RETURN FROM WITHSW
ENDSUB

LINKROUTINE LINKED
        SET TOTAL = 0
        LINK BACK
ENDSUB

ENDSECT MAINSUBS

PRGEND
