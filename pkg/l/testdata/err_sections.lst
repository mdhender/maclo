    1 PRGSTART
    3 SECTION VARS,//AN EXECUTABLE STATEMENT AMONG THE DECLARATIONS//
    4   DEC TOTAL INIT 0
    5   SET TOTAL = 1
    6 ENDSECT VARS
    8 SECTION MAIN,//A DECLARATION AND A DATA STATEMENT AMONG THE LOGIC//
    9   [BEGIN] DEC OTHER
   10   DC 0
   11   GO TO BEGIN
   12 ENDSECT MAIN
   14 SECTION NOSUCH,//A SECTION THAT IS NOT ONE OF THE TEN//
   15 ENDSECT NOSUCH
   17 PRGEND
