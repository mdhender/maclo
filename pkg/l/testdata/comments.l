PRGSTART
/+A HEADING, WHICH OCCUPIES A LINE BY ITSELF+/
//A SUBSIDIARY COMMENT ON A LINE OF ITS OWN//
//A COMMENT WHOSE TEXT CONTAINS A / SLASH//

SECTION VARS,//AFTER A COMMA THE COMMENT IS AN ARGUMENT//
        DEC TOTAL INIT 0
ENDSECT VARS

SECTION INVALS,//PREFIXES SIT ON EITHER SIDE OF THE LABEL//

[BEGIN] /-IN-/SET TOTAL = 0
        /-IN-//-OVP-/SET TOTAL = TOTAL+1
        GO TO MBEGIN

ENDSECT INVALS

SECTION MAIN,//AND ON THE STATEMENT AFTER THEN//

/-CSS-/[MBEGIN] IF TOTAL = 0 THEN /-OVP-/SET TOTAL = TOTAL+1
        GO TO MBEGIN

ENDSECT MAIN

PRGEND
