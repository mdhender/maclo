PRGSTART

SECTION VARS,//NAMES FOR THE BRANCHES AND ASSIGNMENTS//

BLOCKDEC SDB,//BACKSPACE READS A VARIABLE OF THIS BLOCK//
        DEC DBUGPT INIT NULLPT
        DEC SPT INIT ZEROPT
ENDBLOCK SDB

DEC IDPT INIT ZEROPT
DEC BESPT INIT ZEROPT
DEC BESTPL INIT 0
DEC PVNUM INIT 0
DEC TEMP INIT 0
DEC FLAGSW INIT 0
DEC COPDSW INIT 0

ENDSECT VARS

SECTION MAIN,//GO TO, TEST, CHARMATCH, SCALE, BACKSPACE, SET, SETSW, STACK//

[BEGIN] GO TO SWITCH

[SWITCH] TEST BESTPL GOING MNOUT,CALLO,WARNO,SKIPPO,DELLO,BSLOOP,WRNERR,SASTAK,STOPPO,ENDALL

[MNOUT] CHARMATCH IDPT,'+' GOING CALLO,'-' GOING WARNO,'*' GOING SKIPPO,'/' GOING DELLO,'$' GOING BSLOOP

[CALLO] BACKSPACE SPT
[WARNO] BACKSPACE SPT GIVING IDPT
[SKIPPO] SCALE PVNUM BY 4
[DELLO] SCALE PVNUM BY 4 GIVING TEMP

[BSLOOP] SET SPT = IDPT-OF(LNM)
        SET IND(SPT)NM,TEMP = 0
        SET BESTPL,PVNUM = 0
        SETSW FLAGSW = 1
        SETSW FLAGSW = COPDSW
        SETSW FLAGSW = COPDSW & 4
        SETSW FLAGSW = COPDSW | 1

[WRNERR] STACK PVNUM (NM) ON FSTACK
[SASTAK] STACK IDPT (PT) BESPT+OF(LCH) (PT) ON BSTACK
[STOPPO] STACK FLAGSW(SW) 3(NM) TRUE(SW) IDPT-1(PT) ON FSTACK
[ENDALL] UNSTACK TEMP (NM) IDPT (PT) FROM BSTACK
        SET DBUGPT = IDPT
        SET BESPT = IDPT
        GO TO BEGIN

ENDSECT MAIN

PRGEND
