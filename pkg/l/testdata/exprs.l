PRGSTART

SECTION VARS,//NAMES FOR THE EXPRESSIONS BELOW//
        DEC SPT INIT ZEROPT
        DEC IDPT INIT ZEROPT
        DEC IDLEN INIT 0
        DEC HASHPT INIT NULLPT
        DEC FLAGSW INIT 0
ENDSECT VARS

SECTION MAIN,//EVERY SHAPE OF EXPRESSION AND CONSTANT MACRO//

[BEGIN] SET IDLEN = OF(LCH)
        SET IDLEN = OF(2*LNM+LCH)
        SET IDLEN = OF(LHV+4*LPT+LSW)
        SET IDLEN = OF(LNM-LCH)
        SET IDLEN = OF(1/LICH)
        SET SPT = IDPT-OF(LNM)
        SET SPT = -6+IDLEN
        SET IDLEN = IND(SPT)NM
        SETSW FLAGSW = IND(HASHPT+IDLEN-OF(LCH))SW
        SET IDLEN = IND(AD(KSPACE)PT)NM
        SET IND(SPT)NM,IDLEN = 0
        SET HASHPT = AD(KSPACE)PT
        SET IDLEN = TEXMAX-HTMAX
        GO TO BEGIN

ENDSECT MAIN

SECTION DELS,//A DATA LABEL FOR AD TO NAME//
[KSPACE] DC ' '
ENDSECT DELS

PRGEND
