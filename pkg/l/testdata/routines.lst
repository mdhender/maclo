    1 PRGSTART
    3 SECTION VARS,//NAMES THE ROUTINES BELOW USE//
    4   DEC PARPT INIT NULLPT
    5   DEC PARNM INIT 0
    6   DEC PARSW INIT 0
    7   DEC TOTAL INIT 0
    8   DEC FLGSW INIT 0
    9 ENDSECT VARS
   11 SECTION MAIN,//A CALL OF EVERY FORM//
   13   [BEGIN] CALL PLAIN
   14   CALL WITHPT(TOTAL)PT EXIT FAILED
   15   CALL WITHNM(TOTAL+1)NM
   16   CALL WITHSW(FLGSW)SW
   17   CALL MDINIT
   18   CALL MDTEST(PARPT)PT EXIT FAILED
   19   [FAILED] GO TO BEGIN
   21 ENDSECT MAIN
   23 SECTION MAINSUBS,//SUBROUTINES WITH AND WITHOUT A PARAMETER AND AN EXIT//
   25   SUBROUTINE PLAIN
   26     SET TOTAL = 0
   27     RETURN FROM PLAIN
   28   ENDSUB
   30   SUBROUTINE WITHPT(PARPT) EXIT //THE VALUE WAS NOT FOUND//
   31     IF PARPT = NULLPT THEN EXIT FROM WITHPT
   32     SET TOTAL = PARNM
   33     RETURN FROM WITHPT
   34   ENDSUB
   36   SUBROUTINE WITHNM(PARNM)
   37     SET TOTAL = PARNM
   38     RETURN FROM WITHNM
   39   ENDSUB
   41   SUBROUTINE WITHSW(PARSW)
   42     SETSW FLGSW = PARSW
   43     RETURN FROM WITHSW
   44   ENDSUB
   46   LINKROUTINE LINKED
   47     SET TOTAL = 0
   48     LINK BACK
   49   ENDSUB
   51 ENDSECT MAINSUBS
   53 PRGEND
