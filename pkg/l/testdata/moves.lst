    1 PRGSTART
    3 SECTION VARS,//NAMES FOR THE BLOCK MOVES//
    5   BLOCKDEC SDB,//A BLOCK, SO THAT BLOCK( ) HAS SOMETHING TO NAME//
    6     DEC STAKPT INIT NULLPT
    7     DEC ARGCT INIT 0
    8   ENDBLOCK SDB
   10   DEC FROMPT INIT NULLPT
   11   DEC DESTPT INIT NULLPT
   12   DEC IDLEN INIT 0
   14 ENDSECT VARS
   16 SECTION MAIN,//EVERY BLOCK MOVING STATEMENT//
   18   [BEGIN] MOVE FROM FROMPT TO DESTPT LENG IDLEN
   19   MOVE FROM FROMPT TO DESTPT LENG IDLEN BACKWARDS
   20   MOVE FROM BLOCK(SDB) TO DESTPT LENG OF(LPT+LNM)
   21   MSTACK FROM FROMPT LENG IDLEN ON FSTACK
   22   MSTACK FROM BLOCK(SDB) LENG SDBSZ ON BSTACK
   23   MUNSTACK FROM FROMPT TO BLOCK(SDB) LENG SDBSZ FROM BSTACK
   24   SET STAKPT = FROMPT
   25   SET ARGCT = IDLEN
   26   GO TO BEGIN
   28 ENDSECT MAIN
   30 PRGEND
