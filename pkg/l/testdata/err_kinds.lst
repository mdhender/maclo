    1 PRGSTART
    3 SECTION VARS,//A BLOCK AND A VARIABLE FOR THE MISUSES BELOW//
    4   BLOCKDEC SDB,//A BLOCK//
    5     DEC TOTAL INIT 0
    6   ENDBLOCK SDB
    7   DEC DESTPT INIT NULLPT
    8 ENDSECT VARS
   10 SECTION MAIN,//AD, BLOCK AND GO TO EACH NAMING THE WRONG KIND OF THING//
   12   [BEGIN] SET DESTPT = AD(BEGIN)PT
   13   MOVE FROM BLOCK(TOTAL) TO DESTPT LENG SDBSZ
   14   GO TO TOTAL
   15   CALL TOTAL
   17 ENDSECT MAIN
   19 PRGEND
