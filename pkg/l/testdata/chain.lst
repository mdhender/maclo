    1 PRGSTART
    3 SECTION VARS,//THE CHAIN VARIABLES ARE DECLARED LIKE ANY OTHER//
    4   DEC CHANPT INIT NULLPT
    5   DEC CHLINK INIT 0
    6   DEC PARPT INIT NULLPT
    7   DEC DELPT INIT NULLPT
    8   DEC TOTAL INIT 0
    9 ENDSECT VARS
   11 SECTION MAIN,//A CHAIN WHOSE ENDCH CARRIES A BRANCHED-TO LABEL//
   13   [BEGIN] CHAIN FROM DELPT EXIT NOTFND
   14     CALL COMPAR(CHANPT)PT EXIT SKIPIT
   15     SET TOTAL = TOTAL+1
   16     IF CHLINK = 0 THEN GO TO SKIPIT
   17   [SKIPIT] ENDCH
   18   [NOTFND] GO TO BEGIN
   20 ENDSECT MAIN
   22 SECTION MAINSUBS,//THE SUBROUTINE THE CHAIN CALLS//
   24   SUBROUTINE COMPAR(PARPT) EXIT //THE COMPARISON FAILS//
   25     IF PARPT = NULLPT THEN EXIT FROM COMPAR
   26     RETURN FROM COMPAR
   27   ENDSUB
   29 ENDSECT MAINSUBS
   31 PRGEND
