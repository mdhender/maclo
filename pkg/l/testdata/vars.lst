    1 PRGSTART
    3 SECTION VARS,//A DECLARATION OF EVERY SHAPE//
    5   BLOCKDEC OUTER,//A BLOCK, AND ONE NESTED INSIDE IT//
    7     DEC COUNT
    8     DEC BASEPT INIT NULLPT
   10     BLOCKDEC INNER,//THE NESTED CASE, WHICH THE LOGIC USES ONCE//
   12       DEC FLGSW INIT 0
   13       DEC LIMIT INIT 9
   15     ENDBLOCK INNER
   17   ENDBLOCK OUTER
   19   DEC HEADPT INIT AD(TABLE)PT
   20   DEC TOTAL INIT 3
   21   DEC SPARE
   22   EQUATE OTHER TO TOTAL
   24 ENDSECT VARS
   26 SECTION MAIN,//EVERY NAME IS USED, SO NOTHING IS REPORTED UNUSED//
   28   [BEGIN] SET COUNT = OUTERSZ+INNERSZ
   29   SET BASEPT = HEADPT
   30   SETSW FLGSW = 1
   31   SET TOTAL = LIMIT+OTHER
   32   SET SPARE = COUNT
   33   GO TO BEGIN
   35 ENDSECT MAIN
   37 SECTION MACNAMES,//A DATA LABEL FOR AD TO NAME//
   39   [TABLE] DC 0
   41 ENDSECT MACNAMES
   43 PRGEND
