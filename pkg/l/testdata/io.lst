    1 PRGSTART
    3 SECTION VARS,//ONE FLAG FOR THE LOOP BELOW//
    4   DEC OHSW INIT 0
    5 ENDSECT VARS
    7 SECTION ERR,//READ, OUTPUTID AND EVERY SHAPE OF PRTEXT//
    9   [BEGIN] READ
   10   OUTPUTID
   11   PRTEXT[A PLAIN LINE]
   12   PRTEXT[$]
   13   PRTEXT[$$$SOMETHING WENT WRONG$]
   14   PRTEXT[)    ]
   15   PRTEXT[]
   16   PRTEXT[, = + - * / AND ; ARE ALL LEGAL HERE]
   18   //THE NAME IN THESE BRACKETS IS ALSO A LABEL OF THIS PROGRAM//
   20   [TXTO] PRTEXT[SKIP]
   21   [SKIP] SETSW OHSW = 0
   22   IF OHSW = 0 THEN GO TO SKIP
   23   GO TO TXTO
   25 ENDSECT ERR
   27 PRGEND
