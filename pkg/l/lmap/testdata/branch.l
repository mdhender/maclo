PRGSTART

//THE THREE BRANCHING STATEMENTS//

SECTION VARS,//A SELECTOR AND A POINTER TO A CHARACTER//

DEC TYPE INIT 0
DEC SCANPT INIT NULLPT

ENDSECT VARS


SECTION MAIN,//GO TO, TEST AND CHARMATCH//

[START] GO TO FIRST

//TEST IS A MULTI-WAY BRANCH, THE FIRST LABEL STANDING FOR ZERO//

[FIRST] TEST TYPE GOING ZERO,ONE,TWO,ONE,ZERO

//CHARMATCH IS A RUN OF CHARACTER COMPARISONS ON THE SAME POINTER//

[ZERO]  CHARMATCH SCANPT,'A' GOING ONE,'B' GOING TWO,'$' GOING FIRST
[ONE]   CHARMATCH SCANPT,' ' GOING TWO
[TWO]   GO TO START

ENDSECT MAIN

PRGEND
