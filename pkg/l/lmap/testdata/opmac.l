PRGSTART

//OPMAC, WHICH IS ONE ENTRY OF THE TABLE OF OPERATION MACRO NAMES//

SECTION VARS,//NOTHING IS EXECUTED HERE//

DEC CHANPT INIT NULLPT

ENDSECT VARS


SECTION MACNAMES,//A GLOBAL ONE, A LOCAL ONE, AND ONE WITH A COMPOSITE NAME//

OPMAC 'MCDEF',RL(DVARS),LOCMK,4
OPMAC 'MCDEFG',RL(DVARS),OPMK,4
OPMAC 'MCNODEF',ENDCHN,LOCMK,0
OPMAC 'MCLENG'+'(',RL(DRBRAC),OPMK,13
OPMAC 'MCSUB'+'(',RL(DRBRAC),OPMK,14

ENDSECT MACNAMES


SECTION DELS,//THE DELIMITER STRUCTURES THE NAMES ABOVE POINT AT//

[DVARS] DC ENDCHN,LID[VARS],RL(DRBRAC)
[DRBRAC] DC ENDCHN,LID[)],ENDCHN

HETABLES

ENDSECT DELS


SECTION MAIN,//SOMETHING THAT READS THEM//

[START] SET CHANPT = AD(DVARS)PT
        GO TO START

ENDSECT MAIN

PRGEND
