PRGSTART

//THE DATA SECTIONS: EVERY KIND OF TABLE ITEM IN ONE TABLE//

SECTION VARS,//NOTHING IS EXECUTED HERE, BUT VARS HAS TO EXIST//

DEC CHANPT INIT NULLPT
DEC CHLINK INIT 0

ENDSECT VARS


SECTION DELS,//A CHAIN, THE NAMES ON IT, AND THE CHARACTERS THEY STAND FOR//

//AN ITEM IS A LINK, A LENGTH, THE TEXT, AND A LINK TO THE NEXT ALTERNATIVE//

[HEAD]  DC RL(SECOND)
[FIRST] DC RL(THIRD),LID[WITH],RL(FIRST)
[SECOND] DC RL(THIRD)
[THIRD] DC ENDCHN,LID[SPACES],ENDCHN

//A NUMBER, AN OF EXPRESSION, AND A SINGLE CHARACTER OF EACH KIND//

[NUMS]  DC 0,1,OF(LCH),OF(2*LNM+LCH)
[LETTER] DC 'N',ENDCHN
[SPACE] DC ' '
[NEWLIN] DC '$'

//THE LAYOUT CHARACTERS AND THE HASH TABLE ARE THE L-MAP'S TO SUPPLY//

[LAYCHN] LAYCHAIN

HETABLES

ENDSECT DELS


SECTION MAIN,//SOMETHING THAT READS THE TABLE, SO THE NAMES ARE USED//

[START] CHAIN FROM AD(HEAD)PT EXIT DONE
        ENDCH
        SET CHANPT = AD(NUMS)PT
        SET CHANPT = AD(LETTER)PT
        SET CHANPT = AD(SPACE)PT
        SET CHANPT = AD(NEWLIN)PT
        SET CHANPT = AD(LAYCHN)PT
        SET CHANPT = AD(GHSHTB)PT
        SET CHANPT = AD(SVEC)PT
        SET CHANPT = AD(ERBLOC)PT
[DONE]  GO TO START

ENDSECT MAIN

PRGEND
