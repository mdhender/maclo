        PRGST   'L'

        NB      'THE THREE BLOCK MOVING STATEMENTS'
        NB      'THE ALLOCATOR AND THE TWO STACK POINTERS BELONG TO THE LOGIC'

        NB      'A BLOCK, WHICH IS WHAT BLOCK() NAMES'
        NB      'the following are stored contiguously'
        DCL     TOPSPT
        DCL     ARGLEN
        DCL     OPTYP
        NB      'end of the contiguous block'

        DCL     FFPT
        DCL     LFPT
        DCL     IDPT
        DCL     IDLEN
        DCL     TEMPT
        DCL     PARNM


        NB      'variables the L-map needs and L does not'
        DCL     SRCPT
        DCL     DSTPT
        DCL     LOTEMP
        DCL     LOSTOR
        DCL     LOSPIL
        DCL     LOSPI2
        DCL     LOLENG
        DCL     NLSW
        DCL     LOERBL
        DCL     LOSVEC
        DCL     WTHSMK
        DCL     WITHMK
        DCL     EXCLMK
        DCL     SPCSMK

        NB      'A MOVE OF EACH KIND'

[START]
        LAV     IDPT,X
        STV     SRCPT,X
        LAV     FFPT,X
        STV     DSTPT,X
        LAV     IDLEN,X
        FMOVE
        LAV     IDPT,X
        STV     SRCPT,X
        LAV     IDPT,X
        AAV     IDLEN
        STV     DSTPT,X
        LAV     FFPT,X
        SAV     IDPT
        BMOVE
        LAA     TOPSPT,D
        STV     SRCPT,X
        LAV     TEMPT,X
        STV     DSTPT,X
        LAL     OF(3*LNM)
        FMOVE
        LAV     IDLEN,X
        STV     LOLENG,X
        LAV     FFPT,X
        STV     DSTPT,X
        LAV     LOLENG,X
        GOSUB   BUMPFF,0
        LAV     IDPT,X
        STV     SRCPT,X
        LAV     LOLENG,X
        FMOVE
        LAL     OF(3*LNM)
        STV     LOLENG,X
        LAV     LOLENG,X
        GOSUB   DECLF,0
        LAA     TOPSPT,D
        STV     SRCPT,X
        LAV     LFPT,X
        STV     DSTPT,X
        LAV     LOLENG,X
        FMOVE
        LAV     TEMPT,X
        STV     SRCPT,X
        LAA     TOPSPT,D
        STV     DSTPT,X
        LAL     OF(3*LNM)
        STV     LOLENG,X
        LAV     LOLENG,X
        FMOVE
        LAV     SRCPT,X
        AAV     LOLENG
        STV     LFPT,X
        GO      START,0,X,X

        NB      'THE TWO ALLOCATORS THE MANUAL WRITES MSTACK IN TERMS OF'

        SUBR    BUMPFF,PARNM,1
        LAV     FFPT,X
        AAV     PARNM
        STV     FFPT,X
        EXIT    1,BUMPFF

        SUBR    DECLF,PARNM,1
        LAV     LFPT,X
        SAV     PARNM
        STV     LFPT,X
        EXIT    1,DECLF
