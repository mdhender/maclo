PRGSTART

//EVERY SHAPE AN ARITHMETIC EXPRESSION CAN TAKE//

SECTION VARS,//THE NAMES THE EXPRESSIONS BELOW ARE BUILT FROM//

BLOCKDEC BLK,//A BLOCK, SO THAT BLOCK() HAS SOMETHING TO NAME//
        DEC HEADPT
        DEC COUNT
ENDBLOCK BLK

DEC SUMNM INIT 0
DEC WORKPT INIT NULLPT
DEC FLAGSW INIT 0

ENDSECT VARS


SECTION MAIN,//ONE STATEMENT PER FORM//

[START] SET SUMNM = 6
        SET SUMNM = COUNT
        SET SUMNM = OF(2*LNM+LCH)
        SET SUMNM = TRUE
        SET SUMNM = BLKSZ
        SET WORKPT = AD(TABLE)PT
        SET SUMNM = IND(WORKPT)NM
        SET SUMNM = IND(WORKPT+OF(LNM))NM
        SET SUMNM = -SUMNM
        SET SUMNM = -SUMNM-1
        SET SUMNM = COUNT+SUMNM-OF(LNM)+6
        SET SUMNM = IND(HEADPT)NM+HEADPT-OF(LCH)
        SETSW FLAGSW = COUNT
        GO TO START

ENDSECT MAIN


SECTION DELS,//SOMETHING FOR AD TO POINT AT//

[TABLE] DC ENDCHN

ENDSECT DELS

PRGEND
