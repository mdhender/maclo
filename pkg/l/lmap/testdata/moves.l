PRGSTART

//THE THREE BLOCK MOVING STATEMENTS//

SECTION VARS,//THE ALLOCATOR AND THE TWO STACK POINTERS BELONG TO THE LOGIC//

BLOCKDEC OPDB,//A BLOCK, WHICH IS WHAT BLOCK() NAMES//
        DEC TOPSPT
        DEC ARGLEN
        DEC OPTYP
ENDBLOCK OPDB

DEC FFPT INIT NULLPT
DEC LFPT INIT NULLPT
DEC IDPT INIT NULLPT
DEC IDLEN INIT 0
DEC TEMPT INIT NULLPT
DEC PARNM INIT 0

ENDSECT VARS


SECTION MAIN,//A MOVE OF EACH KIND//

[START] MOVE FROM IDPT TO FFPT LENG IDLEN
        MOVE FROM IDPT TO IDPT+IDLEN LENG FFPT-IDPT BACKWARDS
        MOVE FROM BLOCK(OPDB) TO TEMPT LENG OPDBSZ

        MSTACK FROM IDPT LENG IDLEN ON FSTACK
        MSTACK FROM BLOCK(OPDB) LENG OPDBSZ ON BSTACK

        MUNSTACK FROM TEMPT TO BLOCK(OPDB) LENG OPDBSZ FROM BSTACK
        GO TO START

ENDSECT MAIN


SECTION MAINSUBS,//THE TWO ALLOCATORS THE MANUAL WRITES MSTACK IN TERMS OF//

SUBROUTINE BUMPFF(PARNM)
        SET FFPT = FFPT+PARNM
        RETURN FROM BUMPFF
ENDSUB

SUBROUTINE DECLF(PARNM)
        SET LFPT = LFPT-PARNM
        RETURN FROM DECLF
ENDSUB

ENDSECT MAINSUBS

PRGEND
