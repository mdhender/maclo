PRGSTART

//BACKSPACE, WHICH IS DEFINED BY THE OFFSET OF A VARIABLE INSIDE ITS BLOCK//

SECTION VARS,//SDB IS THE BLOCK THE MANUAL NAMES, AND EDB SITS INSIDE IT//

BLOCKDEC SDB,//THE SCANNING DESCRIPTION BLOCK//

        DEC ARGCT

        BLOCKDEC EDB,//THE PART OF IT AN ERROR PRINT-OUT USES//
                DEC STAKPT
                DEC ARGPT
                DEC DBUGPT
                DEC SPT
        ENDBLOCK EDB

        DEC TVARPT
        DEC DBUGSW

ENDBLOCK SDB

DEC TEMPT INIT NULLPT
DEC TEMPSW INIT 0

ENDSECT VARS


SECTION MAIN,//BOTH FORMS, OVER BOTH THE OUTER BLOCK AND THE NESTED ONE//

//WITHOUT GIVING, WHICH LEAVES THE ADDRESS IN TEMPT//

[START] BACKSPACE ARGCT
        BACKSPACE STAKPT
        BACKSPACE SPT
        BACKSPACE DBUGSW

//WITH GIVING, WHICH LEAVES THE VALUE//

        BACKSPACE ARGPT GIVING TEMPT
        BACKSPACE TVARPT GIVING TEMPT
        BACKSPACE DBUGSW GIVING TEMPSW
        GO TO START

ENDSECT MAIN

PRGEND
