PRGSTART

//CHAIN FROM, WHOSE WHOLE RUNTIME IS TWO SUBROUTINES OF THE MD-LOGIC//

SECTION VARS,//CHANPT AND CHLINK ARE THE TWO THE STATEMENT USES ITSELF//

DEC CHANPT INIT NULLPT
DEC CHLINK INIT 0
DEC FOUNDPT INIT NULLPT
DEC TOTAL INIT 0

ENDSECT VARS


SECTION MAIN,//THREE CHAINS: A PLAIN ONE, A LABELLED ENDCH, AND AN EMPTY BODY//

[START] CHAIN FROM AD(TABLE)PT EXIT NOTHING
                SET TOTAL = TOTAL+1
        ENDCH

//THE ENDCH CARRIES A LABEL, WHICH IS WHERE A FAILED TEST CONTINUES FROM//

        CHAIN FROM FOUNDPT EXIT NOTHING
                IF IND(CHANPT)NM = 0 THEN GO TO CONTIN
                SET TOTAL = 0
        [CONTIN] ENDCH

//AN EMPTY BODY WALKS TO THE END AND LEAVES CHANPT ON THE LAST ITEM//

        CHAIN FROM FOUNDPT EXIT NOTHING
        ENDCH
        SET FOUNDPT = CHANPT

[NOTHING] GO TO START

ENDSECT MAIN


SECTION DELS,//A CHAIN OF TWO ITEMS FOR IT TO WALK//

[TABLE] DC RL(SECOND)
[SECOND] DC ENDCHN

ENDSECT DELS

PRGEND
