        PRGST   'L'

        NB      'SUBROUTINES, THEIR EXITS, AND THE LINKROUTINE'
        NB      'THE THREE PARAMETER NAMES ARE EQUATED TO ONE ANOTHER'

        DCL     PARNM
        DCL     TOTAL
        DCL     FLAGSW

        EQU     PARPT,PARNM
        EQU     PARSW,PARNM

        NB      'variables the L-map needs and L does not'
        DCL     SRCPT
        DCL     DSTPT
        DCL     LOTEMP
        DCL     LOSTOR
        DCL     LOSPIL
        DCL     LOSPI2
        DCL     LOLENG
        DCL     NLSW
        DCL     LOERBL
        DCL     LOSVEC
        DCL     WTHSMK
        DCL     WITHMK
        DCL     EXCLMK
        DCL     SPCSMK

        NB      'EVERY FORM OF CALL'

[START]
        GOSUB   PLAIN,0
        LAV     TOTAL,X
        GOSUB   TAKEPT,0
        GO      MISSED,0,X,C
        LAV     TOTAL,X
        AAL     1
        GOSUB   TAKENM,0
        LAV     FLAGSW,X
        GOSUB   TAKESW,0
        GOSUB   LINKED,0
[BACKAT]
        LAL     0
        STV     TOTAL,X
[MISSED]
        GO      START,0,X,X

        NB      'ONE OF EACH SHAPE'

        SUBR    PLAIN,X,1
        LAL     0
        STV     TOTAL,X
        EXIT    1,PLAIN

        NB      'THE VALUE WAS NOT THERE'
        SUBR    TAKEPT,PARNM,2
        LAV     PARPT,X
        CAL     0
        GONE    LOIF1,0,X,X
        EXIT    1,TAKEPT
[LOIF1]
        LAL     1
        STV     TOTAL,X
        EXIT    2,TAKEPT

        SUBR    TAKENM,PARNM,1
        LAV     PARNM,X
        STV     TOTAL,X
        EXIT    1,TAKENM

        SUBR    TAKESW,PARNM,1
        LAV     PARSW,X
        STV     FLAGSW,X
        EXIT    1,TAKESW

        NB      'A LINKROUTINE LEAVES BY A BRANCH AND COMES BACK TO A LABEL INSIDE ITSELF'
        LINKR   LINKED
        LAL     0
        STV     TOTAL,X
        GO      BACKAT,0,X,X
        LINKB
