        PRGST   'L'

        NB      'THE THREE STATEMENT PREFIXES OF APPENDIX A'
        NB      'ONE NAME PER PREFIX'

        DCL     TOTAL
        DCL     LEVEL


        NB      'variables the L-map needs and L does not'
        DCL     SRCPT
        DCL     DSTPT
        DCL     LOTEMP
        DCL     LOSTOR
        DCL     LOSPIL
        DCL     LOSPI2
        DCL     LOLENG
        DCL     NLSW
        DCL     LOERBL
        DCL     LOSVEC
        DCL     WTHSMK
        DCL     WITHMK
        DCL     EXCLMK
        DCL     SPCSMK

        NB      'WHERE THE IN PREFIX BELONGS'

[START]
        LAL     0
        STV     TOTAL,X
        LAL     0
        STV     LEVEL,X
        GO      MBEGIN,0,X,X

        NB      'OVP WHERE ARITHMETIC MAY OVERFLOW, CSS ON A LABEL LEFT INTO'

[MBEGIN]
        LAV     TOTAL,X
        AAL     1
        STV     TOTAL,X
        GOSUB   COUNTUP,0
        GO      MBEGIN,0,X,X
        NB      'A LABEL BRANCHED TO FROM INSIDE A SUBROUTINE, SO THE RETURN ADDRESSES GO'
[GIVEUP]
        CSS
        LAL     0
        STV     TOTAL,X
        GO      MBEGIN,0,X,X

        NB      'THE SUBROUTINE THAT LEAVES WITHOUT RETURNING'

        SUBR    COUNTUP,X,1
        LAV     TOTAL,X
        CAL     100
        GOGR    GIVEUP,0,X,X
        LAV     LEVEL,X
        AAL     1
        STV     LEVEL,X
        EXIT    1,COUNTUP
