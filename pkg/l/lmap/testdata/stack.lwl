        PRGST   'L'

        NB      'STACK, UNSTACK, SCALE, AND THE TWO ASSIGNMENTS'
        NB      'A NUMBER, A POINTER AND A SWITCH, BECAUSE STACK NAMES THE TYPE'

        DCL     COUNT
        DCL     LIMIT
        DCL     WORKPT
        DCL     MARKSW
        DCL     OTHRSW


        NB      'variables the L-map needs and L does not'
        DCL     SRCPT
        DCL     DSTPT
        DCL     LOTEMP
        DCL     LOSTOR
        DCL     LOSPIL
        DCL     LOSPI2
        DCL     LOLENG
        DCL     NLSW
        DCL     LOERBL
        DCL     LOSVEC
        DCL     WTHSMK
        DCL     WITHMK
        DCL     EXCLMK
        DCL     SPCSMK

        NB      'ONE OF EACH'

[START]
        LAV     COUNT,X
        FSTK
        LAV     WORKPT,X
        BSTK
        LAV     MARKSW,X
        BSTK
        LAV     COUNT,X
        AAL     1
        BSTK
        LAV     WORKPT,X
        SAL     OF(LCH)
        BSTK
        UNSTK   MARKSW
        UNSTK   WORKPT
        NB      'SCALE IS THE ONLY MULTIPLICATION L HAS'
        LAV     COUNT,X
        MULTL   OF(LNM)
        STV     COUNT,X
        LAV     COUNT,X
        MULTL   OF(2*LNM)
        STV     LIMIT,X
        NB      'ONE VALUE, SEVERAL PLACES, AND A PLACE THAT IS AN ADDRESS'
        LAL     0
        STV     COUNT,P
        STV     LIMIT,X
        LAV     COUNT,X
        STI     WORKPT,X
        LAV     WORKPT,X
        AAL     OF(LNM)
        STV     LOSTOR,X
        LAV     WORKPT,X
        STI     LOSTOR,P
        STV     WORKPT,X
        LAI     WORKPT,X
        ANDL    4
        STV     MARKSW,X
        LAV     MARKSW,X
        ORL     2
        STV     MARKSW,X
        LAI     WORKPT,X
        ANDV    MARKSW
        STV     MARKSW,P
        STV     OTHRSW,X
        GO      START,0,X,X
