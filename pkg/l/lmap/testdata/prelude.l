PRGSTART

//A WHOLE PROGRAM, SO THAT EVERY PART OF THE MD-LOGIC HAS SOMETHING TO REACH//

//IT IS NOT ML/I. IT IS THE SMALLEST PROGRAM THAT DECLARES EVERYTHING THE//
//L-MAP'S OWN CODE CALLS AND BRANCHES TO, WHICH IS WHAT LETS THE GENERATED//
//LOWL BE ASSEMBLED RATHER THAN ONLY COMPARED//

SECTION VARS,//THE NAMES THE MD-LOGIC READS AND WRITES//

BLOCKDEC SDB,//THE BLOCK AN ERROR PRINT-OUT IS MADE FROM//
        DEC STAKPT
        DEC ARGPT
        DEC DBUGPT
        DEC SPT
        DEC LINECT
        DEC DBUGSW
ENDBLOCK SDB

DEC FFPT INIT NULLPT
DEC LFPT INIT NULLPT
DEC ENDPT INIT NULLPT
DEC PVARPT INIT NULLPT
DEC PVNUM INIT 0
DEC GLBWSW INIT 0
DEC SVARPT INIT AD(SVEC)PT
DEC ETEMPT INIT AD(ERBLOC)PT
DEC HASHPT INIT AD(GHSHTB)PT
DEC HTABPT INIT NULLPT
DEC INFFPT INIT NULLPT
DEC ERIAPT INIT NULLPT
DEC CHANPT INIT NULLPT
DEC CHLINK INIT 0
DEC IDPT INIT NULLPT
DEC IDLEN INIT 0
DEC TLINCT INIT 0
DEC MEVAL INIT 0
DEC OP1 INIT 0
DEC OPSW INIT 0
DEC INVOCT INIT 0
DEC TOTAL INIT 0
DEC PARNM INIT 0
DEC PARPT INIT NULLPT

ENDSECT VARS


SECTION MACNAMES,//ONE COMPOSITE NAME, WHICH IS WHERE THE MARKERS COME FROM//

OPMAC 'MCDEF',RL(DNL),LOCMK,4
OPMAC 'MCLENG'+'(',RL(DNL),OPMK,13

ENDSECT MACNAMES


SECTION DELS,//THE CHAIN, THE LAYOUT CHARACTERS AND THE HASH TABLE//

//AN ITEM IS A LINK, A LENGTH, THE TEXT, AND A LINK TO THE NEXT ALTERNATIVE//

[DNL]   DC ENDCHN,LID[$],ENDCHN
[DWITH] DC RL(DNL),LID[WITH],RL(DWITH)
[NUMS]  DC 0,1,OF(LCH),OF(2*LNM+LCH)
[LETTER] DC 'N',ENDCHN
[SPACE] DC ' '

[LAYCHN] LAYCHAIN

HETABLES

ENDSECT DELS


SECTION INVALS,//THE MI-LOGIC'S OWN INITIALISATION, WHICH BEGIN FALLS INTO//

[BEGIN] /-IN-/SET TOTAL = 0
        /-IN-/SET IDLEN = 0
        GO TO MBEGIN

ENDSECT INVALS


SECTION MAIN,//A LOOP THAT USES EVERY STATEMENT THE MD-LOGIC IS BEHIND//

[MBEGIN] READ
        SET IDPT = SPT
        SET IDLEN = OF(LCH)
        OUTPUTID
        PRTEXT[$READY$]
        CALL MDINIT
        CALL MDFIND
        CALL MDCONV
        CALL MDOP
        CALL MDQUOT
        CALL MDERPR
        CALL MDNUM EXIT NOTANUM
        CALL MDTEST(SPT)PT EXIT NOTANUM
        CHAIN FROM AD(DWITH)PT EXIT NOTANUM
        ENDCH
        SET IDPT = AD(NUMS)PT
        SET IDPT = AD(LETTER)PT
        SET IDPT = AD(SPACE)PT
        SET IDPT = AD(LAYCHN)PT
        GO TO MDGOBC

//THE THREE LABELS THE CLASS TEST ANSWERS THROUGH//

[GOSUC] SET TOTAL = 1
        GO TO MBEGIN
[GOFAIL] SET TOTAL = 0
        GO TO MBEGIN
[NOTANUM] SET TOTAL = 0
        GO TO ERLIA

//WHERE THE MI-LOGIC REPORTS AN ARGUMENT IT CANNOT USE//

/-CSS-/[ERLIA]  PRTEXT[ARGUMENT HAS ILLEGAL VALUE$]
        GO TO MDHALT

ENDSECT MAIN


SECTION MAINSUBS,//THE FOUR SUBROUTINES THE MD-LOGIC CALLS BY NAME//

SUBROUTINE BUMPFF(PARNM)
        SET FFPT = FFPT+PARNM
        IF FFPT GE LFPT THEN GO TO ERLSO
        RETURN FROM BUMPFF
ENDSUB

SUBROUTINE DECLF(PARNM)
        SET LFPT = LFPT-PARNM
        IF FFPT GE LFPT THEN GO TO ERLSO
        RETURN FROM DECLF
ENDSUB

SUBROUTINE PRNUM(PARNM)
        SET MEVAL = PARNM
        CALL MDCONV
        CALL MDERPR
        RETURN FROM PRNUM
ENDSUB

ENDSECT MAINSUBS


SECTION ERR,//STORAGE OVERFLOW, WHICH THE MACHINE BRANCHES TO ON ITS OWN//

/-CSS-/[ERLSO] PRTEXT[PROCESS ABORTED FOR LACK OF STORAGE$]
        GO TO MDABRT

//WHERE ARITHMETIC OVERFLOW IS REPORTED, WHICH DIVISION BY ZERO REACHES//

/-CSS-/[ERLOVF] PRTEXT[ARITHMETIC OVERFLOW$]
        GO TO MDABRT

ENDSECT ERR


SECTION ENVPR,//THE LIST OF CONSTRUCTIONS, WHICH THE FINALISATION CODE CALLS//

SUBROUTINE PRENV
        PRTEXT[$NOTHING IS DEFINED$]
        RETURN FROM PRENV
ENDSUB

ENDSECT ENVPR

PRGEND
