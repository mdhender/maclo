        PRGST   'L'

        NB      'EVERY SHAPE AN ARITHMETIC EXPRESSION CAN TAKE'
        NB      'THE NAMES THE EXPRESSIONS BELOW ARE BUILT FROM'

        NB      'A BLOCK, SO THAT BLOCK() HAS SOMETHING TO NAME'
        NB      'the following are stored contiguously'
        DCL     HEADPT
        DCL     COUNT
        NB      'end of the contiguous block'

        DCL     SUMNM
        DCL     WORKPT
        DCL     FLAGSW


        NB      'variables the L-map needs and L does not'
        DCL     SRCPT
        DCL     DSTPT
        DCL     LOTEMP
        DCL     LOSTOR
        DCL     LOSPIL
        DCL     LOSPI2
        DCL     LOLENG
        DCL     NLSW
        DCL     LOERBL
        DCL     LOSVEC
        DCL     WTHSMK
        DCL     WITHMK
        DCL     EXCLMK
        DCL     SPCSMK

        NB      'ONE STATEMENT PER FORM'

[START]
        LAL     6
        STV     SUMNM,X
        LAV     COUNT,X
        STV     SUMNM,X
        LAL     OF(2*LNM+LCH)
        STV     SUMNM,X
        LAL     1
        STV     SUMNM,X
        LAL     OF(2*LNM)
        STV     SUMNM,X
        LAA     TABLE,C
        STV     WORKPT,X
        LAI     WORKPT,X
        STV     SUMNM,X
        LAV     WORKPT,X
        AAL     OF(LNM)
        STV     LOTEMP,X
        LAI     LOTEMP,X
        STV     SUMNM,X
        LAL     0
        SAV     SUMNM
        STV     SUMNM,X
        LAL     0
        SAV     SUMNM
        SAL     1
        STV     SUMNM,X
        LAV     COUNT,X
        AAV     SUMNM
        SAL     OF(LNM)
        AAL     6
        STV     SUMNM,X
        LAI     HEADPT,X
        AAV     HEADPT
        SAL     OF(LCH)
        STV     SUMNM,X
        LAV     COUNT,X
        STV     FLAGSW,X
        GO      START,0,X,X

        NB      'SOMETHING FOR AD TO POINT AT'

[TABLE]
        CON     0
