        PRGST   'L'

        NB      'THE THREE BRANCHING STATEMENTS'
        NB      'A SELECTOR AND A POINTER TO A CHARACTER'

        DCL     TYPE
        DCL     SCANPT


        NB      'variables the L-map needs and L does not'
        DCL     SRCPT
        DCL     DSTPT
        DCL     LOTEMP
        DCL     LOSTOR
        DCL     LOSPIL
        DCL     LOSPI2
        DCL     LOLENG
        DCL     NLSW
        DCL     LOERBL
        DCL     LOSVEC
        DCL     WTHSMK
        DCL     WITHMK
        DCL     EXCLMK
        DCL     SPCSMK

        NB      'GO TO, TEST AND CHARMATCH'

[START]
        GO      FIRST,0,X,X
        NB      'TEST IS A MULTI-WAY BRANCH, THE FIRST LABEL STANDING FOR ZERO'
[FIRST]
        GOADD   TYPE
        GO      ZERO,0,X,T
        GO      ONE,0,X,T
        GO      TWO,0,X,T
        GO      ONE,0,X,T
        GO      ZERO,0,X,T
        NB      'CHARMATCH IS A RUN OF CHARACTER COMPARISONS ON THE SAME POINTER'
[ZERO]
        LCI     SCANPT,X
        CCL     'A'
        GOEQ    ONE,0,X,X
        LCI     SCANPT,R
        CCL     'B'
        GOEQ    TWO,0,X,X
        LCI     SCANPT,R
        CCN     NLREP
        GOEQ    FIRST,0,X,X
[ONE]
        LCI     SCANPT,X
        CCN     SPREP
        GOEQ    TWO,0,X,X
[TWO]
        GO      START,0,X,X
