PRGSTART

//THE THREE STATEMENT PREFIXES OF APPENDIX A//

SECTION VARS,//ONE NAME PER PREFIX//

DEC TOTAL INIT 0
DEC LEVEL INIT 0

ENDSECT VARS


SECTION INVALS,//WHERE THE IN PREFIX BELONGS//

[START] /-IN-/SET TOTAL = 0
        /-IN-/SETSW LEVEL = 0
        GO TO MBEGIN

ENDSECT INVALS


SECTION MAIN,//OVP WHERE ARITHMETIC MAY OVERFLOW, CSS ON A LABEL LEFT INTO//

[MBEGIN] /-OVP-/SET TOTAL = TOTAL+1
        CALL COUNTUP
        GO TO MBEGIN

//A LABEL BRANCHED TO FROM INSIDE A SUBROUTINE, SO THE RETURN ADDRESSES GO//

/-CSS-/[GIVEUP]  SET TOTAL = 0
        GO TO MBEGIN

ENDSECT MAIN


SECTION MAINSUBS,//THE SUBROUTINE THAT LEAVES WITHOUT RETURNING//

SUBROUTINE COUNTUP
        IF TOTAL GR 100 THEN GO TO GIVEUP
        SET LEVEL = LEVEL+1
        RETURN FROM COUNTUP
ENDSUB

ENDSECT MAINSUBS

PRGEND
