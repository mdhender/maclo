PRGSTART

//SUBROUTINES, THEIR EXITS, AND THE LINKROUTINE//

SECTION VARS,//THE THREE PARAMETER NAMES ARE EQUATED TO ONE ANOTHER//

DEC PARPT INIT NULLPT
DEC PARNM INIT 0
DEC PARSW INIT 0
DEC TOTAL INIT 0
DEC FLAGSW INIT 0

ENDSECT VARS


SECTION MAIN,//EVERY FORM OF CALL//

[START] CALL PLAIN
        CALL TAKEPT(TOTAL)PT EXIT MISSED
        CALL TAKENM(TOTAL+1)NM
        CALL TAKESW(FLAGSW)SW
        CALL LINKED
[BACKAT] SET TOTAL = 0
[MISSED] GO TO START

ENDSECT MAIN


SECTION MAINSUBS,//ONE OF EACH SHAPE//

SUBROUTINE PLAIN
        SET TOTAL = 0
        RETURN FROM PLAIN
ENDSUB

SUBROUTINE TAKEPT(PARPT) EXIT //THE VALUE WAS NOT THERE//
        IF PARPT = NULLPT THEN EXIT FROM TAKEPT
        SET TOTAL = 1
        RETURN FROM TAKEPT
ENDSUB

SUBROUTINE TAKENM(PARNM)
        SET TOTAL = PARNM
        RETURN FROM TAKENM
ENDSUB

SUBROUTINE TAKESW(PARSW)
        SETSW FLAGSW = PARSW
        RETURN FROM TAKESW
ENDSUB

//A LINKROUTINE LEAVES BY A BRANCH AND COMES BACK TO A LABEL INSIDE ITSELF//

LINKROUTINE LINKED
        SET TOTAL = 0
        GO TO BACKAT
        LINK BACK
ENDSUB

ENDSECT MAINSUBS

PRGEND
