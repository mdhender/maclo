PRGSTART

//IF IN BOTH ITS FORMS, WITH EVERY RELATION AND BOTH JOINING OPERATORS//

SECTION VARS,//NAMES FOR THE CONDITIONS BELOW//

DEC LEFTNM INIT 0
DEC RIGHTNM INIT 0
DEC SCANPT INIT NULLPT
DEC MARKSW INIT 0

ENDSECT VARS


SECTION MAIN,//THE CONDITIONS//

//THE FORM THE MANUAL SAYS MOST L-MAPS RECOGNISE//

[START] IF LEFTNM = 0 THEN GO TO AGAIN
        IF LEFTNM NE 0 THEN GO TO AGAIN
        IF LEFTNM GR RIGHTNM THEN GO TO AGAIN
        IF LEFTNM GE RIGHTNM THEN GO TO AGAIN
        IF LEFTNM LE RIGHTNM THEN GO TO AGAIN

//ONE GUARDED STATEMENT, WHICH NEEDS A JOIN//

        IF LEFTNM = RIGHTNM THEN SET LEFTNM = 0

//A BLOCK, WHICH NEEDS THE SAME JOIN//

        IF LEFTNM GR 0 THEN
                SET LEFTNM = LEFTNM-1
                SET RIGHTNM = RIGHTNM+1
        END

//BOTH JOINING OPERATORS, IN BOTH READINGS//

        IF LEFTNM = 0 & RIGHTNM = 0 THEN GO TO AGAIN
        IF LEFTNM = 0 | RIGHTNM = 0 THEN GO TO AGAIN
        IF LEFTNM = 0 & RIGHTNM = 0 THEN SET MARKSW = 0
        IF LEFTNM = 0 | RIGHTNM = 0 THEN SET MARKSW = 0

//A CHARACTER, WHICH IS COMPARED IN A REGISTER OF ITS OWN//

        IF IND(SCANPT)CH = 'A' THEN GO TO AGAIN
        IF IND(SCANPT)CH = ' ' THEN GO TO AGAIN
        IF IND(SCANPT)CH = '$' THEN GO TO AGAIN
        IF IND(SCANPT)CH = STOPCODE THEN GO TO AGAIN
        IF IND(SCANPT)CH NE IND(SCANPT+OF(LCH))CH THEN GO TO AGAIN

//AN END THAT CARRIES A LABEL//

        IF MARKSW = 0 THEN
                SET LEFTNM = 0
        [AGAIN] END
        GO TO START

ENDSECT MAIN

PRGEND
